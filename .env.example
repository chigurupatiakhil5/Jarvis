# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get a free Tavily API key at https://tavily.com (1,000 free searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL connection settings
# Running main.py NATIVELY on your Mac (v2+, needed for microphone access):
#   POSTGRES_HOST=localhost, POSTGRES_PORT=5433 (docker-compose maps host 5433 -> container 5432)
# Running via `docker compose up app` instead (no mic, text input only):
#   POSTGRES_HOST=db, POSTGRES_PORT=5432
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_dev_password
POSTGRES_DB=jarvis
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# "wake" listens continuously and activates when you say "Hey Jarvis" (pretrained model,
#   downloaded automatically — no training needed).
# "voice" records from your microphone after you press Enter, transcribes with local Whisper.
# "text" falls back to typed input — use this if running inside Docker (no mic access).
INPUT_MODE=voice

# "voice" (default) speaks each response aloud with macOS's `say` command.
# "text" only prints it.
OUTPUT_MODE=voice

# Which pretrained openWakeWord model to use for wake-word detection.
WAKE_WORD_MODEL=hey_jarvis

# "say" (default) uses macOS's free, local, unlimited built-in voice.
# "elevenlabs" uses a much more natural cloud voice — needs the two settings below,
# and its free tier is limited (~10,000 characters/month). Falls back to "say"
# automatically if the ElevenLabs call fails for any reason.
TTS_PROVIDER=say

# Get a free API key at https://elevenlabs.io — only needed if TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Pick a voice from your ElevenLabs dashboard's Voice Library and paste its Voice ID here.
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
