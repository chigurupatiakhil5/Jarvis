# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get a free Tavily API key at https://tavily.com (1,000 free searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL connection settings (used by docker-compose and memory/logger.py)
POSTGRES_USER=may
POSTGRES_PASSWORD=may_dev_password
POSTGRES_DB=may
POSTGRES_HOST=db
POSTGRES_PORT=5432
