# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get a free Tavily API key at https://tavily.com (1,000 free searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL connection settings — a free Supabase project (v8+). This same
# database is used by both the local Mac version and the cloud-deployed
# version, so preferences/logs stay unified no matter which one you use.
# Get these from your Supabase project's Settings -> Database page.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_db_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432

# "wake" listens continuously and activates when you say "Hey Jarvis" (pretrained model,
#   downloaded automatically — no training needed).
# "voice" records from your microphone after you press Enter, transcribes with local Whisper.
# "text" falls back to typed input — use this if running inside Docker (no mic access).
INPUT_MODE=voice

# "voice" (default) speaks each response aloud with macOS's `say` command.
# "text" only prints it.
OUTPUT_MODE=voice

# Which pretrained openWakeWord model to use for wake-word detection.
WAKE_WORD_MODEL=hey_jarvis

# "say" uses macOS's free, local, unlimited built-in voice — Mac only, works
#   for the local app but NOT for the browser/cloud path (no bytes to send).
# "piper" (default) uses a free, unlimited, open-source neural voice via a local
#   Piper server — works for both the local app AND the browser/cloud path.
# "elevenlabs" uses a more natural (but quota-limited, ~10,000 chars/month free)
#   cloud voice. Falls back to "say" (local) or fails gracefully (cloud) if unavailable.
TTS_PROVIDER=piper

# Where the Piper HTTP server is running — only needed if TTS_PROVIDER=piper.
# Start it with: python3 -m piper.http_server -m en_GB-alan-medium
PIPER_SERVER_URL=http://localhost:5001

# Get a free API key at https://elevenlabs.io — only needed if TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Pick a voice from your ElevenLabs dashboard's Voice Library and paste its Voice ID here.
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Your location, used by scheduler.py to check real weather against your saved preferences.
# Free, no API key needed (Open-Meteo). Defaults below are Austin, TX.
LOCATION_LAT=30.26715
LOCATION_LON=-97.74306
LOCATION_TIMEZONE=America/Chicago

# How often scheduler.py checks weather against your preferences.
SCHEDULER_CHECK_INTERVAL_MINUTES=30
